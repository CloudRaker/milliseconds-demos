---
import '../styles/site.css';
import '../styles/demos.css';
import KeyPanel from '../components/KeyPanel.astro';
import { ArrowUpIcon } from '@phosphor-icons/react/ssr';
type Props = { title: string; description: string; noindex?: boolean; structuredData?: Record<string, unknown>; image?: string; imageAlt?: string };
const { title, description, noindex = false, structuredData, image = '/og.png', imageAlt = 'milliseconds.ai — interactive decision-machine-1 demos' } = Astro.props;
const socialImage = new URL(image, 'https://demo.milliseconds.ai').href;
const canonical = new URL(Astro.url.pathname, 'https://demo.milliseconds.ai').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#111114" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/SpaceGrotesk-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="demo.milliseconds.ai" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="/" aria-label="milliseconds.ai demos">
          <svg width="21" height="13.5" viewBox="6.8 8.8 22.4 14.4" aria-hidden="true"><path d="M8 22V10l4 7 4-7 4 7 4-7v12" fill="none" stroke="var(--purple-on-dark)" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round" /></svg>
          <span>milliseconds<span class="domain">.ai</span></span>
          <span class="wordmark-tag">demos</span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation"><a href="/">All demos</a><a href="https://milliseconds.ai/">milliseconds.ai</a><a href="https://docs.milliseconds.ai/" target="_blank" rel="noopener noreferrer">Docs</a><a data-auth-out href="https://console.milliseconds.ai/" target="_blank" rel="noopener noreferrer">Login</a></nav>
        <KeyPanel />
        <a data-auth-entry class="header-cta" href="https://console.milliseconds.ai/signup" target="_blank" rel="noopener noreferrer">Sign up</a>
        <details class="mobile-menu"><summary aria-label="Navigation menu"><span></span><span></span></summary><nav aria-label="Mobile navigation"><a href="/">All demos</a><a href="https://milliseconds.ai/">milliseconds.ai</a><a href="https://docs.milliseconds.ai/" target="_blank" rel="noopener noreferrer">Docs</a><a data-auth-out href="https://console.milliseconds.ai/" target="_blank" rel="noopener noreferrer">Login</a><a data-auth-entry href="https://console.milliseconds.ai/signup" target="_blank" rel="noopener noreferrer">Sign up</a></nav></details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="shell">
        <div class="footer-top"><p>Built with <a href="https://milliseconds.ai/">milliseconds.ai</a>. Yours to build on. <a href="https://github.com/CloudRaker/milliseconds-demos">Get the source ↗</a></p></div>
        <div class="footer-bottom"><span>© {new Date().getFullYear()} CloudRaker Inc.</span><span>Montréal, Canada</span><a href="https://trust.cloudraker.com/">Security & trust</a><a href="#main">Back to top <ArrowUpIcon size={16} aria-hidden="true" focusable="false" /></a></div>
      </div>
    </footer>
    <script>
      import { init } from "@plausible-analytics/tracker";
      if (import.meta.env.PROD) init({ domain: "milliseconds.ai" });
      let sessionRequest = 0;
      const refreshSession = () => {
        const request = ++sessionRequest;
        fetch("https://console.milliseconds.ai/api/session", { credentials: "include", cache: "no-store", redirect: "error", signal: AbortSignal.timeout(10_000) })
          .then(response => response.ok ? response.json() : null)
          .then(session => {
            if (request !== sessionRequest || typeof session?.authenticated !== "boolean") return;
            document.querySelectorAll<HTMLElement>("[data-auth-out]").forEach(link => { link.style.display = session.authenticated ? "none" : ""; });
            document.querySelectorAll<HTMLAnchorElement>("[data-auth-entry]").forEach(link => {
              link.href = session.authenticated ? "https://console.milliseconds.ai/" : "https://console.milliseconds.ai/signup";
              link.textContent = session.authenticated ? "Console" : "Sign up";
            });
          }).catch(() => {});
      };
      refreshSession();
      window.addEventListener("focus", refreshSession);
      window.addEventListener("pageshow", refreshSession);
      const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      mobileMenu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { mobileMenu.open = false; }));
    </script>
  </body>
</html>
