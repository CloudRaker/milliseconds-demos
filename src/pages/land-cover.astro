---
import Demo from '../layouts/Demo.astro';
import meta from '../demos/land-cover/meta';
import { config } from '../demos/land-cover/config';
import license from '../demos/land-cover/LICENSE?raw';
import ImageClassifier from '../components/ImageClassifier';
---
<Demo meta={meta}>
  <ImageClassifier config={config} client:only="react" />
  <div slot="notes">
    <details>
      <summary>Image dataset license</summary>
      <pre style="white-space: pre-wrap; font-size: 0.8rem;">{license}</pre>
    </details>
  </div>
</Demo>
