---
import Site from '../layouts/Site.astro';
import DemoIcon from '../components/DemoIcon.astro';
import { ArrowRightIcon } from '@phosphor-icons/react/ssr';
import type { DemoMeta } from '../demos/meta';
import type { ImageDemoConfig } from '../lib/image-demo';
import { SAMPLES as hotDogSamples } from '../demos/hot-dog/samples';
import { RECEIPT } from '../demos/receipt-reader/receipt';
const imageModules = import.meta.glob<{ config: ImageDemoConfig }>('../demos/*/config.ts', { eager: true });
const previews = Object.fromEntries(Object.values(imageModules).filter(m => m.config?.samples).map(m => [m.config.slug, m.config.samples[0]]));
const imagePreviews: Record<string, typeof RECEIPT> = { ...previews, 'hot-dog': hotDogSamples[0], 'receipt-reader': RECEIPT };
const modules = import.meta.glob<{ default: DemoMeta }>('../demos/*/meta.ts', { eager: true });
const demos = Object.values(modules).map((m) => m.default).sort((a, b) => (a.order ?? 99) - (b.order ?? 99) || a.title.localeCompare(b.title));
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Interactive AI demos — milliseconds.ai',
  url: 'https://demo.milliseconds.ai/',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: demos.length,
    itemListElement: demos.map((demo, index) => ({
      '@type': 'ListItem', position: index + 1, name: demo.title,
      url: `https://demo.milliseconds.ai/${demo.slug}/`,
    })),
  },
};
const categories = ['Documents & operations', 'Sales & commerce', 'Customer experience', 'Developer & interactive'];
---
<Site structuredData={structuredData} title="Interactive AI demos · milliseconds.ai" description="Try decision-machine-1 with free stock examples for routing, moderation, search, images, documents and more. Use your own API key for custom input.">
  <section class="demo-head">
    <div class="shell">
      <p class="demo-crumbs"><span>Interactive demos</span></p>
      <h1>Small decisions. Remarkable possibilities.</h1>
      <p class="demo-summary">Photos, text, and decisions your software can act on. Find a workflow by its input or by what you want to do. Explore {demos.length} interactive demos powered by decision-machine-1, with time, tokens, and cost visible as you go. Run the supplied examples for free—no API key needed.</p>
    </div>
  </section>
  <section class="demo-stage">
    <div class="shell">
      {demos.length === 0 && <p class="muted">No demos yet.</p>}
      <div class="demo-filter-section">
        <span class="demo-filter-label" id="input-filter-label">Input</span>
        <div class="demo-filters demo-input-filters" role="group" aria-labelledby="input-filter-label">
          {([['all', 'All inputs'], ['image', 'Images'], ['text', 'Text']] as const).map(([value, label]) =>
            <button class="btn" data-input-filter={value} aria-pressed={value === 'all' ? 'true' : 'false'}>{label} <span>{demos.filter(d => value === 'all' || (d.modality ?? 'text') === value).length}</span></button>
          )}
        </div>
      </div>
      <div class="demo-filter-section">
        <span class="demo-filter-label" id="category-filter-label">Use case</span>
        <div class="demo-filters" role="group" aria-labelledby="category-filter-label">
          <button class="btn" data-demo-filter="all" aria-pressed="true">All use cases <span>{demos.length}</span></button>
          {categories.map(category => <button class="btn" data-demo-filter={category} aria-pressed="false">{category} <span>{demos.filter(d => d.category === category).length}</span></button>)}
        </div>
      </div>
      <p class="demo-filter-count muted small" role="status" aria-live="polite">Showing {demos.length} demos</p>
      <div class="demo-filter-empty" hidden><p>No demos match these filters.</p><button class="btn" data-clear-filters>Clear filters</button></div>
      <div class="demo-grid">
        {demos.map((d) => (
          <a class="demo-card" href={`/${d.slug}/`} data-category={d.category} data-input={d.modality ?? 'text'}>
            <span class="demo-card-input">{d.modality === 'image' ? 'Image input' : 'Text input'}</span>
            <div class="demo-card-heading">
              {imagePreviews[d.slug]
                ? <img class="demo-card-thumbnail" src={imagePreviews[d.slug].dataUrl} alt="" width="28" height="28" loading="lazy" />
                : <DemoIcon slug={d.slug} />}
              <h3>{d.title}</h3>
            </div>
            <p>{d.summary}</p>
            <span class="demo-card-action">Try demo <ArrowRightIcon size={16} aria-hidden="true" focusable="false" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Site>
<script>
  const inputs = [...document.querySelectorAll<HTMLButtonElement>('[data-input-filter]')];
  const categories = [...document.querySelectorAll<HTMLButtonElement>('[data-demo-filter]')];
  const cards = [...document.querySelectorAll<HTMLAnchorElement>('.demo-card')];
  const count = document.querySelector('.demo-filter-count');
  const empty = document.querySelector<HTMLElement>('.demo-filter-empty');
  let input = 'all';
  let category = 'all';

  function render() {
    for (const button of inputs) {
      button.setAttribute('aria-pressed', String(button.dataset.inputFilter === input));
      button.querySelector('span')!.textContent = String(cards.filter(card =>
        (button.dataset.inputFilter === 'all' || card.dataset.input === button.dataset.inputFilter) &&
        (category === 'all' || card.dataset.category === category)).length);
    }
    for (const button of categories) {
      button.setAttribute('aria-pressed', String(button.dataset.demoFilter === category));
      button.querySelector('span')!.textContent = String(cards.filter(card =>
        (input === 'all' || card.dataset.input === input) &&
        (button.dataset.demoFilter === 'all' || card.dataset.category === button.dataset.demoFilter)).length);
    }
    let shown = 0;
    for (const card of cards) {
      card.hidden = (input !== 'all' && card.dataset.input !== input) || (category !== 'all' && card.dataset.category !== category);
      if (!card.hidden) shown++;
    }
    if (count) count.textContent = `Showing ${shown} ${input === 'all' ? '' : input + ' '}${shown === 1 ? 'demo' : 'demos'}${category === 'all' ? '' : ` in ${category}`}`;
    if (empty) empty.hidden = shown !== 0;
  }
  function readUrl() {
    const query = new URLSearchParams(location.search);
    input = inputs.some(button => button.dataset.inputFilter === query.get('input')) ? query.get('input')! : 'all';
    category = categories.some(button => button.dataset.demoFilter === query.get('category')) ? query.get('category')! : 'all';
    render();
  }
  function updateUrl() {
    const url = new URL(location.href);
    for (const [key, value] of [['input', input], ['category', category]]) {
      if (value === 'all') url.searchParams.delete(key);
      else url.searchParams.set(key, value);
    }
    history.pushState(null, '', url);
    render();
  }
  for (const button of inputs) button.addEventListener('click', () => { input = button.dataset.inputFilter!; updateUrl(); });
  for (const button of categories) button.addEventListener('click', () => { category = button.dataset.demoFilter!; updateUrl(); });
  document.querySelector('[data-clear-filters]')?.addEventListener('click', () => { input = 'all'; category = 'all'; updateUrl(); });
  window.addEventListener('popstate', readUrl);
  readUrl();
</script>
