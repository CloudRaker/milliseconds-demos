---
import {
  AirTrafficControlIcon, ChatCircleDotsIcon, CodeBlockIcon, CommandIcon,
  CursorClickIcon, FilesIcon, GitDiffIcon, GraphIcon, HeadsetIcon, MapTrifoldIcon,
  NotepadIcon, PaperPlaneTiltIcon, PulseIcon, RocketLaunchIcon, ShieldCheckIcon,
  ShoppingBagOpenIcon, TableIcon, TerminalWindowIcon, TrayIcon, WaveformIcon,
  HamburgerIcon, ReceiptIcon, ScanIcon, FunnelIcon, BarcodeIcon, FileMagnifyingGlassIcon, FileLockIcon, PackageIcon,
  RecycleIcon, WallIcon, LeafIcon, GlobeHemisphereWestIcon, CoffeeIcon, OrangeIcon,
} from '@phosphor-icons/react/ssr';

// The same Phosphor family as rakerone-web, rendered to static SVG by Astro.
const icons = {
  'invoice-desk': ReceiptIcon,
  'receipt-reader': ScanIcon,
  'sales-intake': FunnelIcon,
  'catalog-studio': BarcodeIcon,
  'evidence-check': FileMagnifyingGlassIcon,
  'private-share': FileLockIcon,
  'returns-desk': PackageIcon,
  'agent-assist': HeadsetIcon,
  'ax-pilot': CursorClickIcon,
  'commit-sentry': GitDiffIcon,
  dispatch: MapTrifoldIcon,
  firehose: ChatCircleDotsIcon,
  'inbox-blitz': TrayIcon,
  'instant-search': ShoppingBagOpenIcon,
  'jev-lint': CodeBlockIcon,
  'judge-sheets': TableIcon,
  launcher: RocketLaunchIcon,
  'live-minutes': NotepadIcon,
  'log-sentinel': PulseIcon,
  modstream: ShieldCheckIcon,
  'nl-palette': CommandIcon,
  'send-guard': PaperPlaneTiltIcon,
  'shell-guard': TerminalWindowIcon,
  swarm: GraphIcon,
  tower: AirTrafficControlIcon,
  'turbo-rerank': FilesIcon,
  'voice-turn': WaveformIcon,
  'hot-dog': HamburgerIcon,
  'waste-sorter': RecycleIcon,
  'crack-check': WallIcon,
  'leaf-check': LeafIcon,
  'land-cover': GlobeHemisphereWestIcon,
  'roast-check': CoffeeIcon,
  'produce-check': OrangeIcon,
};
interface Props { slug: string; }
const { slug } = Astro.props;
const Icon = icons[slug as keyof typeof icons];
if (!Icon) throw new Error(`Choose a demo icon for ${slug}`);
---
<Icon className="demo-icon" size={28} weight="regular" aria-hidden="true" focusable="false" />
